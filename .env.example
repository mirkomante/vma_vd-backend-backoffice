# Copiare in `.env` (non committato) e valorizzare per lo sviluppo locale.
# La connessione PostgreSQL effettiva si verifica in Fase 1.3 — vedi fase-1-db-postgres.md.

# Secret Payload per firma sessione e token (generare con: openssl rand -hex 32)
PAYLOAD_SECRET=

# Connection string PostgreSQL locale (convenzione progetto: DATABASE_URL)
DATABASE_URL=postgresql://<utente>:<password>@127.0.0.1:5432/<nome-database>
