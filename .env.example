# Copiare in `.env` (non committato) e valorizzare per lo sviluppo locale.
# I valori di produzione si configurano in Fase 3, non qui.

# Secret Payload per firma sessione e token (generare con: openssl rand -hex 32)
PAYLOAD_SECRET=

# Connection string PostgreSQL (convenzione Payload: DATABASE_URL).
# Sviluppo locale: host 127.0.0.1:5432, database es. vma_vd_dev (vedi fase-1-db-postgres.md).
# Produzione (Cloud SQL, ADR-110): secret in GCP Secret Manager (§ 3.2); da locale solo
# temporaneamente per migrate/seed, via Auth Proxy su 127.0.0.1:5433 e sslmode=disable —
# vedi docs/operativo/cloud-sql-produzione.md (nessuna password reale in questo file).
DATABASE_URL=postgresql://<utente>:<password>@127.0.0.1:5432/<nome-database>

# Seed super-admin locale (sottofase 2.8). Valori reali solo in `.env`, mai committati.
# Policy password: minimo 8 caratteri, almeno una maiuscola, una minuscola e una cifra.
# Esecuzione: pnpm seed:super-admin
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# URL pubblico canonico (OAuth redirect, link email). Preferire APP_PUBLIC_URL: letta a runtime
# (Cloud Run: env plain — cambio dominio = aggiornare env + redirect Google, senza rebuild).
# NEXT_PUBLIC_URL resta fallback solo per dev locale (Next inlines le NEXT_PUBLIC al build Docker).
APP_PUBLIC_URL=http://localhost:3000
# NEXT_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — email transazionali (sottofase 2.6). Valori reali solo in `.env`.
# Progetto: sottodominio verificato mail.vietnamonamour.com (percorso b, §2.6).
# Vedi docs/operativo/credenziali-resend.md (DNS, API key, stato Verified).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=info@mail.vietnamonamour.com
RESEND_FROM_NAME=Backoffice - Vietnamonamour
